# ===========================================================================
# Trazza — configuración de entorno (copiar a .env y completar en el VPS)
# ===========================================================================

# --- Imágenes (GitHub Container Registry) ---
# Owner del repo en GHCR y tag a desplegar.
IMAGE_REPO=ghcr.io/pel-matiasvaldivia
IMAGE_TAG=latest

# --- Puertos expuestos al host (los proxea tu Nginx Proxy Manager) ---
# Apuntá tus proxy hosts de NPM a estos puertos.
WEB_PORT=8090          # Frontend + landing  -> app.tudominio.com
API_PORT=8091          # API REST directa    -> api.tudominio.com (para devices/mobile)

# --- Object storage (MinIO) — opcional exponer por NPM ---
MINIO_PORT=9000        # S3 API      -> s3.tudominio.com
MINIO_CONSOLE_PORT=9090 # Consola web -> minio.tudominio.com

# --- MQTT (ingesta de dispositivos GPS/LoRa) ---
MQTT_PORT=1883
# Prefijo de topics que consume el bridge MQTT->ingesta.
# Convención: <prefix>/<tenantId>/<deviceIdentifier>  con payload JSON {lat,lng,battery,...}
MQTT_TOPIC_PREFIX=trazza

# --- Traccar (servidor de tracking GPS, dentro del stack) ---
# UI de administración -> traccar.tudominio.com (proxeable por NPM).
TRACCAR_PORT=8082
# Imagen (pineá una versión si querés reproducibilidad, ej. traccar/traccar:6.7).
TRACCAR_IMAGE=traccar/traccar:latest
# UUID del cliente (tenant) al que Traccar asigna las posiciones que reenvía.
# Lo ves en el panel -> sección Dispositivos. Sin esto, el reenvío no resuelve activo.
TRACCAR_TENANT_ID=

# --- PostgreSQL (TimescaleDB + PostGIS) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_super_admin
POSTGRES_DB=trazza

# Rol de aplicación NO-superusuario (obligatorio para que RLS aplique).
APP_DB_USER=trazza_app
APP_DB_PASSWORD=CHANGE_ME_app_role

# Cadena de conexión que usa la API (rol app, NO postgres).
DATABASE_URL=postgres://trazza_app:CHANGE_ME_app_role@db:5432/trazza

# --- Auth / seguridad ---
JWT_SECRET=CHANGE_ME_una_cadena_larga_y_aleatoria
# Token compartido que los dispositivos envían al endpoint de ingesta.
INGEST_TOKEN=CHANGE_ME_token_de_ingesta

# --- MinIO credenciales ---
MINIO_ROOT_USER=trazza
MINIO_ROOT_PASSWORD=CHANGE_ME_minio
# Bucket para las fotos de activos.
MINIO_BUCKET=trazza
# Host público con el que el NAVEGADOR alcanza MinIO (para firmar las URLs de
# subida/descarga). En el VPS: https://s3.tudominio.com (proxy host de NPM).
MINIO_PUBLIC_URL=http://localhost:9000
